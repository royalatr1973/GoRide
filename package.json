{
  "name": "freedom-ride-backend",
  "version": "1.0.0",
  "description": "Freedom — Voice-first AI ride-sharing platform for Chennai",
  "main": "src/server.js",
  "scripts": {
    "start": "node --max-http-header-size=65536 src/server.js",
    "dev": "nodemon --max-http-header-size=65536 src/server.js",
    "migrate": "knex migrate:latest --knexfile src/db/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile src/db/knexfile.js",
    "seed": "knex seed:run --knexfile src/db/knexfile.js",
    "test": "jest --coverage",
    "lint": "eslint src/"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "knex": "^3.1.0",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "socket.io": "^4.7.4",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "uuid": "^9.0.0",
    "joi": "^17.11.0",
    "@anthropic-ai/sdk": "^0.32.1",
    "axios": "^1.6.5",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "eslint": "^8.56.0"
  }
}
